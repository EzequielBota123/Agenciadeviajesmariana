# ─────────────────────────────────────────────────────────────
# TARIFA·VIVA — variables de entorno
# Copiá este archivo a .env.local para desarrollo.
# En Vercel: Project Settings → Environment Variables.
# NADA de esto es obligatorio para arrancar: sin variables la app
# corre con store en memoria y proveedor de tarifas simulado.
# ─────────────────────────────────────────────────────────────

# ── Base de datos (Vercel Postgres / Neon) ──────────────────
# Sin esta variable, los datos viven en memoria y se pierden al
# reiniciar el proceso (en Vercel eso es cada request en frío).
# Para producción es OBLIGATORIA.
DATABASE_URL=

# ── Panel de administración ─────────────────────────────────
# Token que protege /admin y las rutas de escritura de la API.
# Si queda vacío, el panel queda ABIERTO (solo para desarrollo local).
ADMIN_TOKEN=

# ── Agente de lenguaje (Claude) ─────────────────────────────
# Habilita la extracción de fecha/pasajeros/ruta desde texto libre
# ("quiero ir a Cancún el 15 de nov, somos 2").
# Sin esta clave se usa el parser por reglas (regex), que cubre los
# casos más comunes en español pero es menos flexible.
ANTHROPIC_API_KEY=

# ── Proveedor de tarifas ────────────────────────────────────
# mock     → simulador determinístico por día (default, sirve para demo)
# amadeus  → Amadeus Self-Service Flight Offers Search (tarifas reales)
# http     → worker propio (scraping/GDS) expuesto como HTTP JSON
FARE_PROVIDER=mock

# --- amadeus ---
# https://developers.amadeus.com  (test: test.api.amadeus.com)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test.api.amadeus.com

# --- http (worker propio) ---
# POST {FARE_WORKER_URL} con el FareQuery en el body; debe devolver
# un FareResult (ver src/lib/fares/types.ts).
FARE_WORKER_URL=
FARE_WORKER_TOKEN=

# ── Cron de Vercel ──────────────────────────────────────────
# Vercel manda "Authorization: Bearer $CRON_SECRET" a las rutas de cron.
CRON_SECRET=

# ── URL pública (para armar los links de cotización) ────────
# En Vercel se completa sola con VERCEL_URL si la dejás vacía.
NEXT_PUBLIC_BASE_URL=
